{
	email {$ACME_EMAIL}
}

(headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Referrer-Policy same-origin
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Cross-Origin-Opener-Policy same-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=(), interest-cohort=()"
		-Server
	}
}

(app) {
	import headers
	reverse_proxy anubis:3000 {
		header_up X-Real-IP {remote_host}
		header_up X-Http-Version {http.request.proto}
		header_up X-TLS-SNI-Name {http.request.tls.server_name}
		header_up X-Wintersehn-App {args[0]}
	}
}

{$DOMAIN} {
	import app wintersehn
}

monolith.{$DOMAIN} {
	import app monolith
}

search.{$DOMAIN} {
	import app search
}

http://:8080 {
	bind 127.0.0.1
	import headers
	reverse_proxy origin:80 {
		header_up Host search.{$DOMAIN}
		header_up X-Wintersehn-App search
	}
}
