:80 {
	encode gzip

	handle /api/* {
		reverse_proxy {
			dynamic a backend 8000 {
				refresh 5s
			}
			health_uri /api/health/
			health_interval 1s
			health_timeout 1s
			lb_try_duration 3s
		}
	}

	handle /django-admin/* {
		reverse_proxy {
			dynamic a backend 8000 {
				refresh 5s
			}
			health_uri /api/health/
			health_interval 1s
			health_timeout 1s
			lb_try_duration 3s
		}
	}

	handle /static/* {
		reverse_proxy {
			dynamic a backend 8000 {
				refresh 5s
			}
			health_uri /api/health/
			health_interval 1s
			health_timeout 1s
			lb_try_duration 3s
		}
	}

	handle /media/* {
		reverse_proxy {
			dynamic a backend 8000 {
				refresh 5s
			}
			health_uri /api/health/
			health_interval 1s
			health_timeout 1s
			lb_try_duration 3s
		}
	}

	@searxng {
		header X-Wintersehn-App search
		path /searxng/search /searxng/image /searxng/config
	}

	handle @searxng {
		uri strip_prefix /searxng
		reverse_proxy searxng:8080
	}

	handle {
		map {header.X-Wintersehn-App} {app_root} {
			monolith /srv/monolith
			search /srv/search
			default /srv/wintersehn
		}
		root * {app_root}
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@pages not path /assets/*
		header @pages Cache-Control "no-cache"
		header @pages Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-NGaRIuIezg7IdQlGheo5V+TU5ihfTeRveZVWeOIWSvU='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; media-src 'self' blob:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
		try_files {path} /index.html
		file_server
	}
}
