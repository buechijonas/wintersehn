{
	email {$ACME_EMAIL}
}

(app) {
	reverse_proxy anubis:3000 {
		header_up X-Real-IP {remote_host}
		header_up X-Http-Version {http.request.proto}
		header_up X-TLS-SNI-Name {http.request.tls.server_name}
		header_up X-Wintersehn-App {args[0]}
	}
}

{$DOMAIN} {
	import app wintersehn
}

monolith.{$DOMAIN} {
	import app monolith
}
