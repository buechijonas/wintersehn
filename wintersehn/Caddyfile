:80 {
	encode gzip

	handle /api/* {
		reverse_proxy {
			dynamic a backend 8000 {
				refresh 5s
			}
			health_uri /api/health/
			health_interval 1s
			health_timeout 1s
			lb_try_duration 3s
		}
	}

	handle /django-admin/* {
		reverse_proxy {
			dynamic a backend 8000 {
				refresh 5s
			}
			health_uri /api/health/
			health_interval 1s
			health_timeout 1s
			lb_try_duration 3s
		}
	}

	handle /static/* {
		reverse_proxy {
			dynamic a backend 8000 {
				refresh 5s
			}
			health_uri /api/health/
			health_interval 1s
			health_timeout 1s
			lb_try_duration 3s
		}
	}

	handle /media/* {
		reverse_proxy {
			dynamic a backend 8000 {
				refresh 5s
			}
			health_uri /api/health/
			health_interval 1s
			health_timeout 1s
			lb_try_duration 3s
		}
	}

	handle {
		map {header.X-Wintersehn-App} {app_root} {
			monolith /srv/monolith
			default /srv/wintersehn
		}
		root * {app_root}
		try_files {path} /index.html
		file_server
	}
}
